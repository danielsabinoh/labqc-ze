<Window x:Class="LabQC.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LabQC — Gestão de Laboratório" Width="1200" Height="760" Background="#F4F6F8" WindowStartupLocation="CenterScreen">
 <Window.Resources><SolidColorBrush x:Key="Primary" Color="#174F4F"/><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="3"/></Style></Window.Resources>
  <Grid><Grid x:Name="LoginPanel" Background="#EEF2F2"><Border Width="420" Padding="34" Background="White" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="LabQC" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Primary}"/><TextBlock Text="Gestão de Laboratório e Qualidade" Margin="0,0,0,24"/><TextBlock Text="Usuário"/><TextBox x:Name="UsernameBox"/><TextBlock Text="Senha" Margin="0,10,0,0"/><PasswordBox x:Name="PasswordBox" Padding="8" Margin="3" KeyDown="PasswordBox_KeyDown"/><TextBlock x:Name="LoginError" Foreground="#B3261E" Margin="3,8" TextWrapping="Wrap"/><Button Content="Entrar" Click="Login_Click" Background="{StaticResource Primary}" Foreground="White"/><TextBlock x:Name="FirstAccessHint" Text="Primeiro acesso: admin / Admin@123. A troca da senha será obrigatória." FontSize="11" Foreground="#667777" Margin="3,12" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel></Border></Grid>
  <Grid x:Name="Shell" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#123F40"><StackPanel><TextBlock Text="LabQC" Foreground="White" FontSize="28" FontWeight="Bold" Margin="22,24,22,4"/><TextBlock x:Name="CurrentUserText" Foreground="#BBD0D0" Margin="22,0,22,24"/><Button Content="Dashboard" Tag="0" Click="Nav_Click"/><Button Content="Lançar análises" Tag="1" Click="Nav_Click"/><Button Content="Lotes e histórico" Tag="2" Click="Nav_Click"/><Button Content="Produtos" Tag="3" Click="Nav_Click"/><Button Content="Certificados" Tag="4" Click="Nav_Click"/><Button Content="Backup" Tag="5" Click="Nav_Click"/><Button Content="Minha conta" Click="MyAccount_Click" Margin="3,25,3,3"/></StackPanel></Border>
   <TabControl x:Name="Pages" Grid.Column="1" Background="#F4F6F8" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Height" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></TabControl.Resources>
    <TabItem><StackPanel Margin="28"><TextBlock Text="Dashboard" FontSize="28"/><WrapPanel Margin="0,20"><Border Background="White" Padding="22" Margin="5" Width="210"><StackPanel><TextBlock Text="Lotes em análise"/><TextBlock x:Name="InAnalysisCount" FontSize="34"/></StackPanel></Border><Border Background="White" Padding="22" Margin="5" Width="210"><StackPanel><TextBlock Text="Aguardando liberação"/><TextBlock x:Name="AwaitingCount" FontSize="34"/></StackPanel></Border><Border Background="White" Padding="22" Margin="5" Width="210"><StackPanel><TextBlock Text="Não conformidades"/><TextBlock x:Name="NonConformityCount" FontSize="34" Foreground="#B3261E"/></StackPanel></Border></WrapPanel></StackPanel></TabItem>
    <TabItem><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Lançamento de análises" FontSize="28"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16"><ComboBox x:Name="LotPicker" Width="320" DisplayMemberPath="Display" SelectionChanged="LotPicker_SelectionChanged"/><Button Content="Nova amostra (Ctrl+N)" Click="NewSample_Click"/><Button Content="Salvar (Ctrl+S)" Click="SaveAnalysis_Click"/></StackPanel><DataGrid x:Name="AnalysisGrid" Grid.Row="2" AutoGenerateColumns="True" CanUserAddRows="False" PreviewKeyDown="AnalysisGrid_PreviewKeyDown"/></Grid></TabItem>
    <TabItem><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Lotes e histórico" FontSize="28"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><Button Content="+ Abrir novo lote" Click="NewLot_Click" Background="{StaticResource Primary}" Foreground="White"/><Button Content="Enviar para liberação" Click="SubmitLot_Click"/><Button Content="Aprovar" Click="ApproveLot_Click"/><Button Content="Reprovar" Click="RejectLot_Click"/><Button Content="Atualizar" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="LotsGrid" Grid.Row="2" Margin="0,8" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/></Grid></TabItem>
    <TabItem><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions><TextBlock Text="Produtos e análises" FontSize="28"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><Button Content="+ Produto" Click="NewProduct_Click" Background="{StaticResource Primary}" Foreground="White"/><Button Content="Alterar / configurar produto" Click="EditProduct_Click"/><Button Content="Excluir produto" Click="DeleteProduct_Click"/><Button Content="Atualizar" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="ProductsGrid" Grid.Row="2" Margin="0,4" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/><TextBlock Grid.Row="3" Text="Parâmetros de análise" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,5"/><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="+ Parâmetro" Click="NewParameter_Click"/><Button Content="Alterar parâmetro" Click="EditParameter_Click"/><Button Content="Excluir parâmetro" Click="DeleteParameter_Click"/></StackPanel><DataGrid x:Name="ParametersGrid" Grid.Row="5" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/></Grid></TabItem>
    <TabItem><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Certificados e laudos" FontSize="28"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><Button Content="Emitir certificado / laudo" Click="IssueCertificate_Click" Background="{StaticResource Primary}" Foreground="White"/><Button Content="Abrir PDF selecionado" Click="OpenCertificate_Click"/><Button Content="Atualizar" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="CertificatesGrid" Grid.Row="2" Margin="0,8" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/></Grid></TabItem>
    <TabItem><StackPanel Margin="28"><TextBlock Text="Backup" FontSize="28"/><TextBlock Text="Backup consistente do banco e certificados, com verificação de integridade." Margin="0,16"/><WrapPanel><Button Content="Fazer backup agora" Click="Backup_Click"/><Button Content="Verificar backup" Click="VerifyBackup_Click"/></WrapPanel><TextBlock x:Name="BackupStatus" Margin="3,18" TextWrapping="Wrap"/></StackPanel></TabItem>
   </TabControl></Grid></Grid></Window>
