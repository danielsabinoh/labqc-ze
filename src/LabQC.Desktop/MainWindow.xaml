<Window x:Class="LabQC.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabQC — Alimentos do Zé — v0.5" Width="1320" Height="840"
        MinWidth="1080" MinHeight="700" Background="#F7F4F1" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/labqc.ico" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#C91524"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#671017"/>
        <SolidColorBrush x:Key="Gold" Color="#F4B51B"/>
        <SolidColorBrush x:Key="Muted" Color="#716765"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#3D3332"/>
            <Setter Property="BorderBrush" Value="#DED5D2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="12,2"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="3"/><Setter Property="BorderBrush" Value="#D7CFCC"/><Setter Property="Background" Value="#FFFDFC"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="BorderBrush" Value="#D7CFCC"/><Setter Property="Background" Value="#FFFDFC"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2DAD7"/>
            <Setter Property="RowHeight" Value="39"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EFE9E7"/>
            <Setter Property="AlternatingRowBackground" Value="#FCF9F7"/><Setter Property="RowBackground" Value="White"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
        </Style>
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Background="White" BorderBrush="#E1D5D1" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="4" MinWidth="235">
                <StackPanel>
                    <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" Foreground="#5D1117" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HorizontalProductsPanel"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="LoginPanel" Background="#F5F0ED">
            <Border Width="920" Height="525" Background="White" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.16" Color="#5B2626"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="18,0,0,18">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7A1018" Offset="0"/><GradientStop Color="#D31827" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Grid Margin="36">
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="White" CornerRadius="14" Padding="18" Margin="0,0,0,25"><Image Source="pack://application:,,,/Assets/company-logo.jpg" Height="135" Stretch="Uniform"/></Border>
                                <TextBlock Text="Controle de qualidade com segurança, rastreabilidade e agilidade." Foreground="White" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="28"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="J. C. Oliveira &amp; Filhos Ltda.  •  Cianorte - PR" Foreground="#FFD9D9" FontSize="12"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="48" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/labqc-icon.png" Width="66" Height="66" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="Bem-vindo ao LabQC" FontSize="28" FontWeight="Bold" Foreground="#43191B"/>
                        <TextBlock Text="Gestão de Laboratório e Qualidade" Foreground="{StaticResource Muted}" Margin="0,5,0,28"/>
                        <TextBlock Text="Usuário" FontWeight="SemiBold"/><TextBox x:Name="UsernameBox" FontSize="15"/>
                        <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,13,0,0"/><PasswordBox x:Name="PasswordBox" Padding="10" Margin="3" FontSize="15" KeyDown="PasswordBox_KeyDown"/>
                        <TextBlock x:Name="LoginError" Foreground="#B3261E" Margin="3,9" TextWrapping="Wrap"/>
                        <Button Content="Entrar no sistema" Click="Login_Click" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Center"/>
                        <TextBlock x:Name="FirstAccessHint" Text="Primeiro acesso: admin / Admin@123. A troca da senha será obrigatória." FontSize="11" Foreground="#7B6664" Margin="3,12" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PrimaryDark}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,20,18,14">
                        <Border Background="White" CornerRadius="10" Padding="10"><Image Source="pack://application:,,,/Assets/company-logo.jpg" Height="68" Stretch="Uniform"/></Border>
                        <TextBlock Text="LABORATÓRIO DE QUALIDADE" Foreground="#FFD15C" FontSize="11" FontWeight="Bold" Margin="5,13,5,4"/>
                        <TextBlock x:Name="CurrentUserText" Foreground="#F3DCDD" Margin="5,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button Content="Visão geral" Tag="0" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="Lançar análises" Tag="1" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="Lotes e histórico" Tag="2" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="Produtos e parâmetros" Tag="3" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="Certificados e laudos" Tag="4" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button Content="Backup" Tag="5" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                        <Button x:Name="AccessNavButton" Content="Usuários e acessos" Tag="6" Click="Nav_Click" Style="{StaticResource NavButton}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button Content="Minha conta" Click="MyAccount_Click" Style="{StaticResource NavButton}"/>
                        <TextBlock Text="Alimentos do Zé" Foreground="#D5A9AC" FontSize="11" Margin="30,10,15,0"/>
                        <TextBlock Text="J. C. Oliveira &amp; Filhos Ltda.&#x0a;CNPJ 78.704.90/0001-30&#x0a;Cianorte - Paraná" Foreground="#C8999D" FontSize="10" Margin="30,4,15,0" LineHeight="15"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="Pages" Grid.Column="1" Background="#F7F4F1" BorderThickness="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Height" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></TabControl.Resources>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="Visão geral" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="O que precisa de atenção hoje" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="16,0,0,4"/></DockPanel>
                        <WrapPanel Grid.Row="1" Margin="0,18,0,12">
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="4" Width="205"><StackPanel><TextBlock Text="Lotes abertos" Foreground="{StaticResource Muted}"/><TextBlock x:Name="InAnalysisCount" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="4" Width="205"><StackPanel><TextBlock Text="Com pendências" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PendingCount" FontSize="34" FontWeight="SemiBold" Foreground="#B56A00"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="4" Width="205"><StackPanel><TextBlock Text="Fora da especificação" Foreground="{StaticResource Muted}"/><TextBlock x:Name="NonConformityCount" FontSize="34" FontWeight="SemiBold" Foreground="#B3261E"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="20" Margin="4" Width="205"><StackPanel><TextBlock Text="Lotes encerrados" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AwaitingCount" FontSize="34" FontWeight="SemiBold"/></StackPanel></Border>
                        </WrapPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="+ Abrir novo lote" Click="DashboardNewLot_Click" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Lançar análises" Click="DashboardAnalysis_Click"/>
                            <TextBlock x:Name="DashboardAlert" VerticalAlignment="Center" Margin="18,0" Foreground="#8A4D00" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Lotes recentes" FontSize="18" FontWeight="SemiBold" Margin="4,8"/>
                        <DataGrid x:Name="RecentLotsGrid" Grid.Row="4" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="RecentLotsGrid_MouseDoubleClick"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="Lançamento de análises" FontSize="28" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="+ Iniciar novo lote" Click="NewLotFromAnalysis_Click" Style="{StaticResource PrimaryButton}"/></DockPanel>
                        <TextBlock Grid.Row="1" Text="1. Escolha a família" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ListBox x:Name="AnalysisFamilyPicker" Grid.Row="2" Height="82" Margin="0,5" Background="Transparent" BorderThickness="0" ItemsPanel="{StaticResource HorizontalProductsPanel}" ItemTemplate="{StaticResource ProductCardTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="AnalysisFamilyPicker_SelectionChanged"/>
                        <TextBlock Grid.Row="3" Text="2. Escolha o produto e a unidade" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <ListBox x:Name="AnalysisProductPicker" Grid.Row="4" Height="92" Margin="0,5" Background="Transparent" BorderThickness="0" ItemsPanel="{StaticResource HorizontalProductsPanel}" ItemTemplate="{StaticResource ProductCardTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="AnalysisProductPicker_SelectionChanged"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5,0,10"><TextBlock Text="3. Lote aberto" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0"/><ComboBox x:Name="LotPicker" Width="330" FontSize="15" Padding="7" DisplayMemberPath="Display" SelectionChanged="LotPicker_SelectionChanged"/><Button Content="Nova amostra (Ctrl+N)" Click="NewSample_Click"/><Button Content="Salvar (Ctrl+S)" Click="SaveAnalysis_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
                        <DataGrid x:Name="AnalysisGrid" Grid.Row="6" AutoGenerateColumns="True" CanUserAddRows="False" PreviewKeyDown="AnalysisGrid_PreviewKeyDown"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="Lotes e histórico" FontSize="28" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="+ Abrir novo lote" Click="NewLot_Click" Style="{StaticResource PrimaryButton}"/></DockPanel>
                        <TextBlock Grid.Row="1" Text="1. Escolha a família" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ListBox x:Name="LotsFamilyPicker" Grid.Row="2" Height="82" Margin="0,5" Background="Transparent" BorderThickness="0" ItemsPanel="{StaticResource HorizontalProductsPanel}" ItemTemplate="{StaticResource ProductCardTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="LotsFamilyPicker_SelectionChanged"/>
                        <TextBlock Grid.Row="3" Text="2. Escolha o produto e a unidade" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <ListBox x:Name="LotsProductPicker" Grid.Row="4" Height="92" Margin="0,5" Background="Transparent" BorderThickness="0" ItemsPanel="{StaticResource HorizontalProductsPanel}" ItemTemplate="{StaticResource ProductCardTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="LotsProductPicker_SelectionChanged"/>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,3,0,8"><Button Content="Fechar lote" Click="CloseLot_Click"/><Button Content="Atualizar" Click="Refresh_Click"/><TextBlock Text="Dê dois cliques para abrir a ficha completa do lote." VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource Muted}"/></StackPanel>
                        <DataGrid x:Name="LotsGrid" Grid.Row="6" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="LotsGrid_MouseDoubleClick"/>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                        <TextBlock Text="Produtos e parâmetros" FontSize="28" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProductSearchBox" Width="300" HorizontalAlignment="Left" ToolTip="Pesquisar por nome, unidade ou código" TextChanged="ProductSearch_TextChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="+ Produto" Click="NewProduct_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Alterar / configurar" Click="EditProduct_Click"/><Button Content="Duplicar" Click="DuplicateProduct_Click"/><Button Content="Excluir / arquivar" Click="DeleteProduct_Click"/></StackPanel></Grid>
                        <DataGrid x:Name="ProductsGrid" Grid.Row="2" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="ProductsGrid_MouseDoubleClick"/>
                        <TextBlock Grid.Row="3" Text="Parâmetros de análise" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,5"/>
                        <Grid Grid.Row="4" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ParameterSearchBox" Width="300" HorizontalAlignment="Left" ToolTip="Pesquisar parâmetro" TextChanged="ParameterSearch_TextChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="+ Parâmetro" Click="NewParameter_Click"/><Button Content="Alterar" Click="EditParameter_Click"/><Button Content="Excluir / arquivar" Click="DeleteParameter_Click"/></StackPanel></Grid>
                        <DataGrid x:Name="ParametersGrid" Grid.Row="5" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="ParametersGrid_MouseDoubleClick"/>
                    </Grid>
                </TabItem>

                <TabItem><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Certificados e laudos" FontSize="28" FontWeight="SemiBold"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><Button Content="Emitir certificado / laudo" Click="IssueCertificate_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Abrir PDF selecionado" Click="OpenCertificate_Click"/><Button Content="Atualizar" Click="Refresh_Click"/></StackPanel><DataGrid x:Name="CertificatesGrid" Grid.Row="2" Margin="0,8" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/></Grid></TabItem>
                <TabItem><StackPanel Margin="28"><TextBlock Text="Backup" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Backup consistente do banco e certificados, com verificação de integridade." Margin="0,16"/><WrapPanel><Button Content="Fazer backup agora" Click="Backup_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Verificar backup" Click="VerifyBackup_Click"/></WrapPanel><TextBlock x:Name="BackupStatus" Margin="3,18" TextWrapping="Wrap"/></StackPanel></TabItem>
                <TabItem>
                    <Grid Margin="28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel><StackPanel><TextBlock Text="Usuários e acessos" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Crie acessos individuais e controle quem pode utilizar o sistema." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="+ Criar novo acesso" Click="NewUser_Click" Style="{StaticResource PrimaryButton}"/></DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10"><Button Content="Ativar / desativar acesso" Click="ToggleUser_Click"/><Button Content="Atualizar" Click="Refresh_Click"/><TextBlock Text="Novos usuários devem trocar a senha provisória no primeiro acesso." VerticalAlignment="Center" Margin="15,0" Foreground="{StaticResource Muted}"/></StackPanel>
                        <DataGrid x:Name="UsersGrid" Grid.Row="2" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" IsReadOnly="True" SelectionMode="Single"/>
                        <Border Grid.Row="3" Background="#FFF3D5" BorderBrush="#F0D184" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><Image Source="pack://application:,,,/Assets/labqc-icon.png" Width="54" Height="54" Margin="0,0,14,0"/><StackPanel><TextBlock Text="ALIMENTOS DO ZÉ • J. C. Oliveira &amp; Filhos Ltda." FontWeight="Bold" Foreground="#671017"/><TextBlock Text="Estrada Jequitibá Lt 592, Distrito São Lourenço • Cianorte - PR • qualidade@alimentosdoze.com.br" Foreground="#6D5A45" Margin="0,4,0,0"/></StackPanel></StackPanel></Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
