<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\labqc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\labqc.ico" />
    <Resource Include="Assets\labqc-icon.png" />
    <Resource Include="Assets\company-logo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabQC.Application\LabQC.Application.csproj" />
    <ProjectReference Include="..\LabQC.Infrastructure\LabQC.Infrastructure.csproj" />
    <ProjectReference Include="..\LabQC.Reports\LabQC.Reports.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

</Project>
